# ===== RF CIP Mobile Field Control — 환경설정 예시 =====
# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. (docs/PILOT_GUIDE.md 참고)

# --- 데이터베이스 ---
ADMIN_DATABASE_URL=postgres://postgres:비밀번호@localhost:5432/postgres
DATABASE_NAME=rfcip
APP_DB_USER=rfcip_app
APP_DB_PASSWORD=여기에-강한-비밀번호        # 운영에서는 개발 기본값이면 서버가 켜지지 않습니다
DATABASE_URL=postgres://rfcip_app:여기에-강한-비밀번호@localhost:5432/rfcip

# --- 인증 ---
JWT_SECRET=32자-이상의-무작위-문자열        # openssl rand -hex 32
JWT_EXPIRES_IN=12h

# --- 서버 ---
PORT=3000
# 운영 도메인. 카카오톡 메시지의 상세보기 링크가 이 주소로 만들어집니다.
# 운영(NODE_ENV=production)에서는 필수입니다.
PUBLIC_BASE_URL=https://rfcip.example.com

# --- 파일 저장 ---
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_ROOT=../storage
