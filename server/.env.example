# 마이그레이션/시드용 관리자 접속 (DDL 권한 필요)
ADMIN_DATABASE_URL=postgres://postgres@localhost:5432/postgres
DATABASE_NAME=rfcip

# 런타임 애플리케이션 접속 (rfcip_app / NOINHERIT)
APP_DB_USER=rfcip_app
APP_DB_PASSWORD=change-me-in-production
DATABASE_URL=postgres://rfcip_app:change-me-in-production@localhost:5432/rfcip

JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRES_IN=12h
PORT=3000

# 파일 저장소 (§3 벤더 비종속)
STORAGE_BACKEND=LOCAL
STORAGE_LOCAL_ROOT=../storage
